ACESTEP_BASE_URL=https://your-private-gpu-service.example
ACESTEP_API_KEY=
ACESTEP_MODEL=acestep-v15-turbo
# Disable when the service runs without its optional language model.
ACESTEP_THINKING=true
# Turbo: 8 recommended. Base models: consult upstream guidance.
ACESTEP_INFERENCE_STEPS=8
ALLOWED_ORIGINS=https://your-studio.example
GENERATION_TIMEOUT=1800
