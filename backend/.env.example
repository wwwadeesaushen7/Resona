DATA_DIR=data
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MODEL_PROVIDER=acestep
# URL of your actual ACE-Step 1.5 API server. Leave empty to disable generation.
ACESTEP_BASE_URL=
ACESTEP_API_KEY=
ACESTEP_MODEL=acestep-v15-turbo
# Disable when the service runs without its optional language model.
ACESTEP_THINKING=true
# Turbo: 8 recommended. Base models: consult upstream guidance.
ACESTEP_INFERENCE_STEPS=8
GENERATION_TIMEOUT=1800
MAX_UPLOAD_MB=100
MAX_AUDIO_SECONDS=600
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
